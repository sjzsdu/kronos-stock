# Kronos股票预测系统 - 环境变量配置模板
# 复制此文件为 .env 并设置您的实际配置值

# ============ Flask基础配置 ============
FLASK_CONFIG=development
FLASK_ENV=development
FLASK_DEBUG=True

# Flask会话密钥（生产环境请使用强随机密钥）
# 生成方法: python -c "import secrets; print(secrets.token_hex(16))"
SECRET_KEY=your-secret-key-here

# ============ 用户认证安全配置 ============
# JWT密钥（用于生成和验证JWT令牌）
# 生成方法: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=your-jwt-secret-key-change-me

# 会话超时时间（秒，默认24小时）
PERMANENT_SESSION_LIFETIME=86400

# 密码策略配置
PASSWORD_MIN_LENGTH=8
PASSWORD_REQUIRE_NUMBERS=True
PASSWORD_REQUIRE_SPECIAL=True

# 登录安全限制
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_DURATION=1800

# ============ 数据库配置 ============
# 开发环境使用SQLite（默认，保持空值）
DATABASE_URL=

# 生产环境使用MySQL（取消注释并配置）
# DATABASE_URL=mysql+pymysql://username:password@localhost:3306/kronos_stock

# 或使用分离的数据库配置变量：
# DB_USER=root
# DB_PASSWORD=your_mysql_password
# DB_HOST=localhost
# DB_PORT=3306
# DB_NAME=kronos_stock

# 数据库连接池配置
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=3600

# ============ 邮件服务配置 ============
# 邮件服务器配置（用于密码重置等功能）
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USE_SSL=False
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-email-app-password
MAIL_DEFAULT_SENDER=your-email@gmail.com

# ============ 跨域资源共享配置 ============
CORS_ORIGINS=http://localhost:5000,http://localhost:5001,http://127.0.0.1:5000,http://127.0.0.1:5001

# ============ 股票预测API配置 ============
# 预测API限制
MAX_PREDICTION_DAYS=30
DEFAULT_TEMPERATURE=0.7
DEFAULT_MODEL=kronos-mini

# 并发预测数量限制
MAX_CONCURRENT_PREDICTIONS=3

# 股票数据提供商配置
STOCK_DATA_PROVIDER=china_stock_data
STOCK_DATA_API_KEY=your-api-key-if-needed

# 数据更新频率（分钟）
DATA_UPDATE_INTERVAL=15

# ============ 文件上传配置 ============
# 用户头像上传
UPLOAD_FOLDER=app/static/uploads
MAX_UPLOAD_SIZE=5242880  # 5MB
ALLOWED_EXTENSIONS=png,jpg,jpeg,gif

# ============ Redis配置（可选，用于会话和缓存）============
REDIS_URL=redis://localhost:6379/0
USE_REDIS_SESSIONS=False

# ============ 日志配置 ============
LOG_LEVEL=INFO
LOG_FILE=logs/app.log
LOG_MAX_SIZE=10485760  # 10MB
LOG_BACKUP_COUNT=5

# ============ 性能和监控配置 ============
# 缓存配置
CACHE_TYPE=simple
CACHE_DEFAULT_TIMEOUT=300

# 请求频率限制
RATELIMIT_STORAGE_URL=redis://localhost:6379/1
RATELIMIT_DEFAULT=1000 per hour

# 应用性能监控
ENABLE_PROFILING=False
PROFILING_SAMPLE_RATE=0.1

# 健康检查端点
HEALTH_CHECK_ENDPOINT=/api/health

# ============ 安全Headers配置 ============
# 内容安全策略
CONTENT_SECURITY_POLICY=default-src 'self'; script-src 'self' 'unsafe-inline' https://unpkg.com; style-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://cdnjs.cloudflare.com; font-src 'self' https://cdnjs.cloudflare.com; img-src 'self' data: https:;

# ============ 第三方服务配置 ============
# Sentry错误监控（可选）
SENTRY_DSN=your-sentry-dsn-if-using

# Google Analytics（可选）
GA_TRACKING_ID=your-ga-tracking-id-if-using

# ============ 开发环境配置 ============
FLASK_RUN_HOST=127.0.0.1
FLASK_RUN_PORT=5001
FLASK_RUN_DEBUG=True

# 自动重载监听文件
FLASK_RUN_EXTRA_FILES=app/templates,app/static

# ============ 测试环境配置 ============
# 测试数据库
TEST_DATABASE_URL=sqlite:///test_kronos_stock.db

# 测试安全配置
WTF_CSRF_ENABLED=True
TESTING=False